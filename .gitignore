# Rust build artifacts
target/

# Test workspace (large, contains iteration artifacts)
doctrack-workspace/

# Benchmark runs ARE committed — see CONTRIBUTING.md. Scratch output goes to
# benchmarks/local/ so it can be kept out of the way without hiding real runs.
benchmarks/local/

# OS files
.DS_Store

# Claude settings (user-specific)
.claude/

# MCP config (contains absolute paths, generated by doctrack init)
.mcp.json

# Skills lock file and installed skills (auto-generated by npx skills add)
skills-lock.json
.agents/
